# NEXORA Environment Configuration

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg://kaustubh@localhost:5432/nexora_db
# For Docker Compose:
# DATABASE_URL=postgresql+psycopg://postgres:nexorapassword@db:5432/nexora_db

# Security & Authentication
SECRET_KEY=nexora-super-secret-production-key-2026-very-secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Configuration
# Supported: "local" (default deterministic 384-D vector engine & grounded synthesis), "openai", "gemini", "ollama"
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash

# Hybrid Ranking Weights
WEIGHT_SEMANTIC=0.60
WEIGHT_SKILL=0.25
WEIGHT_EXPERIENCE=0.10
WEIGHT_LOCATION=0.05

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
